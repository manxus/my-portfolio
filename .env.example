ADMIN_USER=admin
ADMIN_PASS=changeme

# Steam Web API — https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key
STEAM_ID=your_steam_id

# TMDB v3 API key — https://www.themoviedb.org/settings/api
# Powers the "Find on TMDB" search in the admin editor for the Cinema page (dev only).
TMDB_API_KEY=your_tmdb_v3_api_key

# Contact (email or URL) sent in the User-Agent to OpenStreetMap Nominatim,
# which the admin travel-location search uses (dev only). Their usage policy asks for one.
NOMINATIM_CONTACT=
