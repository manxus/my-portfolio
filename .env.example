ADMIN_USER=admin
ADMIN_PASS=changeme

# --- Live-site admin (set these in Vercel, not here; see README) ---
# Signs admin tokens on Vercel; 32+ random characters. Locally a per-start random secret is used.
# ADMIN_TOKEN_SECRET=
# Optional 2FA: a base32 TOTP secret shared with your authenticator app.
# ADMIN_TOTP_SECRET=
# Fine-grained token for this repo only: Contents + Actions read/write.
# GITHUB_TOKEN=
# GITHUB_REPO=manxus/my-portfolio
# GITHUB_BRANCH=main
# Vercel deploy hook (Settings -> Git -> Deploy Hooks); PUBLISH calls it as a backup.
# VERCEL_DEPLOY_HOOK_URL=
# Build-time flag that ships the admin UI in production builds.
# VITE_ADMIN_ENABLED=true

# Steam Web API — https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key
STEAM_ID=your_steam_id

# TMDB v3 API key — https://www.themoviedb.org/settings/api
# Powers the "Find on TMDB" search in the admin editor for the Cinema page (dev only).
TMDB_API_KEY=your_tmdb_v3_api_key

# Contact (email or URL) sent in the User-Agent to OpenStreetMap Nominatim,
# which the admin travel-location search uses (dev only). Their usage policy asks for one.
NOMINATIM_CONTACT=
